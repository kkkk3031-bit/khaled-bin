#!/bin/bash
# The one way to start the discord-backup-bot (self-hosted on the VPS since
# Railway hit its billing usage limit on 2026-08-13 and stopped provisioning).
# Mirrors twdl-serve: lock, health-check first, only restart if actually asked.
set -u

APP=$HOME/discord-backup-bot
PORT=4420
LOG=$APP/bot.log
LOCK=$HOME/.cache/backupbot-serve.lock

exec 9>"$LOCK"
flock -w 60 9 || { echo "another backupbot-serve is running — skipped"; exit 0; }

healthy()   { curl -fs -o /dev/null -m 10 "http://localhost:$PORT/"; }
listening() { ss -ltn "sport = :$PORT" 2>/dev/null | grep -q LISTEN; }

if [ "${1:-ensure}" = "ensure" ] && healthy; then
  exit 0
fi

fuser -k "$PORT/tcp" >/dev/null 2>&1
pkill -f "$APP/.venv/bin/python3 bot.py" >/dev/null 2>&1
for _ in $(seq 30); do listening || break; sleep 0.5; done
if listening; then
  echo "port $PORT still held after 15s — not starting a second bot" >&2
  exit 1
fi

cd "$APP" || exit 1
setsid nohup .venv/bin/python3 bot.py >> "$LOG" 2>&1 < /dev/null 9>&- &

for _ in $(seq 60); do
  healthy && { echo "backup-bot up on $PORT"; exit 0; }
  sleep 1
done
echo "backup-bot did not come up on $PORT" >&2
exit 1
