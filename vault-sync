#!/usr/bin/env bash
# Commit + push the Obsidian vault so desktop Obsidian (Obsidian Git plugin) pulls it.
set -e
cd ~/vault
git pull -q --no-edit --rebase 2>/dev/null || true
if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git status --porcelain)" ]; then
  git add -A
  git commit -q -m "vault: ${1:-update $(date -u +%F\ %H:%M) UTC}"
  git push -q
  echo "vault synced"
else
  echo "vault clean — nothing to sync"
fi
