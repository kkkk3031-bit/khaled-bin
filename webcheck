#!/bin/bash
# webcheck — auto-fetch ALL Railway + Vercel app URLs and test which are working.
# Usage: webcheck            (uses cached URL list, fast)
#        webcheck --refresh  (re-fetch URL lists from Railway + Vercel APIs first)
set -u
CACHE=~/.cache/webcheck
mkdir -p "$CACHE"

refresh_railway() {
  echo "Fetching Railway domains..."
  local tmp; tmp=$(mktemp -d)
  cd "$tmp" || return 1
  railway list --json 2>/dev/null > projects.json
  python3 - << 'PYEOF' > "$CACHE/railway.txt"
import json, subprocess
for p in json.load(open('projects.json')):
    envs = p['environments']['edges']
    if not envs: continue
    env = envs[0]['node']['name']
    r = subprocess.run(['railway','link','--project',p['id'],'--environment',env],
                       capture_output=True, timeout=30)
    if r.returncode != 0: continue
    r = subprocess.run(['railway','status','--json'], capture_output=True, text=True, timeout=30)
    try: d = json.loads(r.stdout)
    except Exception: continue
    for e in d.get('environments',{}).get('edges',[]):
        for si in e['node'].get('serviceInstances',{}).get('edges',[]):
            doms = si['node'].get('domains') or {}
            for x in doms.get('serviceDomains',[]) + doms.get('customDomains',[]):
                print(f"{p['name']}\t{x['domain']}", flush=True)
PYEOF
  cd - >/dev/null; rm -rf "$tmp"
}

refresh_vercel() {
  echo "Fetching Vercel URLs..."
  { vercel project ls 2>/dev/null; vercel project ls --next 9999999999999 2>/dev/null; } |
    grep -oE '[a-zA-Z0-9-]+ +https://[a-z0-9.-]+\.vercel\.app' |
    awk '{gsub("https://","",$2); print $1"\t"$2}' > "$CACHE/vercel.txt"
  # fallback: pull all pages via --next token loop is not supported; keep page1 + known page2
  if [ ! -s "$CACHE/vercel.txt" ]; then
    vercel project ls 2>&1 | grep -oE 'https://[a-z0-9.-]+\.vercel\.app' | sed 's|https://||; s|^|?\t|' > "$CACHE/vercel.txt"
  fi
}

if [ "${1:-}" = "--refresh" ] || [ ! -s "$CACHE/railway.txt" ]; then refresh_railway; fi
if [ "${1:-}" = "--refresh" ] || [ ! -s "$CACHE/vercel.txt" ]; then refresh_vercel; fi

# Domains to never test/report (retired/abandoned apps) — one per line, `#` comments OK.
touch "$CACHE/ignore.txt"

echo "Testing all URLs..."
{
  sed 's/^/railway\t/' "$CACHE/railway.txt"
  sed 's/^/vercel\t/'  "$CACHE/vercel.txt"
} | grep -vFf <(grep -v '^#' "$CACHE/ignore.txt") | while IFS=$'\t' read -r plat name dom; do
  [ -z "$dom" ] && continue
  echo "$plat|$name|$dom"
done | xargs -P 30 -I{} bash -c '
  IFS="|" read -r plat name dom <<< "{}"
  body=$(mktemp)
  code=$(curl -s -o "$body" -w "%{http_code}" -m 20 "https://$dom/")
  # A platform placeholder means nothing was ever deployed there — that is PARKED,
  # not an outage. Anything else non-2xx/3xx is a real failure worth waking webfix.
  #   railway "Application not found" = no service | "failed to respond" = crashed
  #   vercel  DEPLOYMENT_NOT_FOUND    = no deploy  | NOT_FOUND = deployed, no route at /
  state=up
  case "$code" in
    2*|3*) ;;
    *) if head -c 400 "$body" | grep -qE "Application not found|DEPLOYMENT_NOT_FOUND"; then
         state=parked
       else state=down; fi ;;
  esac
  rm -f "$body"
  printf "%s\t%s\t%s\t%s\t%s\n" "$code" "$plat" "$name" "$dom" "$state"
' | sort > "$CACHE/results.txt"

echo
echo "=== ✅ WORKING (2xx/3xx) ==="
awk -F'\t' '$5=="up" {printf "%-4s %-8s %-28s https://%s\n",$1,$2,$3,$4}' "$CACHE/results.txt"
echo
echo "=== ❌ DOWN (should be up, is not) ==="
awk -F'\t' '$5=="down" {printf "%-4s %-8s %-28s https://%s\n",$1,$2,$3,$4}' "$CACHE/results.txt"
echo
echo "=== 💤 PARKED (nothing deployed — not an outage) ==="
awk -F'\t' '$5=="parked" {printf "%-4s %-8s %-28s https://%s\n",$1,$2,$3,$4}' "$CACHE/results.txt"
echo
awk -F'\t' 'BEGIN{u=0;d=0;p=0} $5=="up"{u++} $5=="down"{d++} $5=="parked"{p++}
  END{print "TOTAL: "u" working, "d" down, "p" parked"}' "$CACHE/results.txt"
